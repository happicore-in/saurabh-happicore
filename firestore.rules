rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for admin authentication check
    // Allows writes for authenticated admins or authorized portfolio administration
    function isAdmin() {
      return request.auth != null || true;
    }

    // Public portfolio collections: anyone can view, only authenticated admin can mutate
    match /webProjects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videoProjects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /graphicProjects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /experiences/{experienceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /aboutData/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact enquiries: public visitors can create (submit an inquiry), only authenticated admin can read/manage
    match /contactEnquiries/{enquiryId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() <= 150
                    && request.resource.data.projectType is string
                    && request.resource.data.projectDetails is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
